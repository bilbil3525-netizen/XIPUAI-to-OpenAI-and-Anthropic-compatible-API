# ============================================================
#  XJTLU Junmou AI relay - environment template
#  Copy to .env and fill in.  NEVER commit the real .env.
# ============================================================

# ---- Your XJTLU account (used by auth_v4.py for the SSO login) ----
# Username format: Firstname.LastnameNN   e.g. San.Zhang24
XJTLU_USERNAME=
XJTLU_PASSWORD=

# ---- Filled in automatically by auth_v4.py ----
# JWT captured from the `jm-token` request header.
JM_TOKEN=
# Optional extras the web app also sends.
BROWSERID=
LANGUAGE=

# ---- Legacy: the 2026 redesign no longer sends this header ----
# Kept only for backward compatibility. The adapter works without it.
SDP_SESSION=

# ---- Written automatically by adapter.py ----
HEARTBEAT_SESSION_ID=
EXPIRE=False
